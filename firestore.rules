rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // System & Platform Config (Allows candidates and apps to read platform settings like Gemini API Key)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated() && 
                      (request.auth.token.email == 'rodrigoalto25@gmail.com' || request.auth.uid == 'MofrK18CvYXsecnf8a6WynBeJWN2');
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interviewsCount']));
    }

    // Interviews
    match /interviews/{interviewId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
                      (request.resource.data.isCandidateInvite == true && request.resource.data.userId is string);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
